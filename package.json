{
  "name": "orca",
  "version": "0.7.0-rc.2",
  "private": true,
  "description": "ORCA - Orchestration Runtime for Coding Agents. A workflow engine that sits above AI-SDLC agent steps, passing artifacts between agents over ACP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @orca/app run build:renderer",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:renderer": "vitest run --config vitest.renderer.config.ts",
    "app:smoke": "playwright test --config packages/app/test/smoke/playwright.config.ts --project=smoke",
    "app:type-proof": "playwright test --config packages/app/test/smoke/playwright.config.ts --project=type-proof",
    "app:admission-intents": "playwright test --config packages/app/test/smoke/playwright.config.ts --project=admission-intents",
    "app:revision-workflow": "playwright test --config packages/app/test/smoke/playwright.config.ts --project=revision-workflow",
    "app:type-proof:update": "playwright test --config packages/app/test/smoke/playwright.config.ts --project=type-proof --update-snapshots",
    "lint": "eslint . && pnpm run lint:css",
    "lint:css": "node tools/eslint-config/bin/check-css-tokens.js packages/app/renderer packages/design/css/components.css",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "node tools/format-check.js",
    "design:build": "node packages/design/build-tokens.js",
    "design:check": "node packages/design/build-tokens.js --check",
    "design:fonts": "node tools/font-build/build-fonts.js",
    "orca": "tsx packages/cli/src/main.ts",
    "demo": "tsx packages/cli/src/main.ts demo",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @orca/app run typecheck:renderer"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@orca/eslint-config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0"
  }
}
