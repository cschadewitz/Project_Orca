{
  "name": "orca",
  "version": "0.2.0",
  "private": true,
  "description": "ORCA - Orchestration Runtime for Coding Agents. A workflow engine that sits above AI-SDLC agent steps, passing artifacts between agents over ACP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @orca/app run build:renderer",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:build": "node packages/design/build-tokens.js",
    "design:check": "node packages/design/build-tokens.js --check",
    "design:fonts": "node tools/font-build/build-fonts.js",
    "orca": "tsx packages/cli/src/main.ts",
    "demo": "tsx packages/cli/src/main.ts demo",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @orca/app run typecheck:renderer"
  },
  "devDependencies": {
    "@orca/eslint-config": "workspace:*",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
