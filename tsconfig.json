{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@orca/core": ["./packages/core/src/index.ts"],
      "@orca/core/schemas": ["./packages/core/src/schemas.ts"],
      "@orca/store": ["./packages/store/src/index.ts"],
      "@orca/agents": ["./packages/agents/src/index.ts"],
      "@orca/engine": ["./packages/engine/src/index.ts"],
      "@orca/testing/child-bundle": ["./packages/testing/src/child-bundle.ts"],
      "@orca/testing": ["./packages/testing/src/index.ts"],
      "@orca/integrations/mcp": ["./packages/integrations/src/mcp/index.ts"],
      "@orca/integrations": ["./packages/integrations/src/index.ts"],
      "@orca/cli": ["./packages/cli/src/index.ts"],
      "@orca/protocol/update-window": ["./packages/protocol/src/update-window.ts"],
      "@orca/protocol/first-run-fence": ["./packages/protocol/src/first-run-fence.ts"],
      "@orca/protocol/remote-access": ["./packages/protocol/src/remote-access.ts"],
      "@orca/protocol": ["./packages/protocol/src/index.ts"],
      "@orca/daemon": ["./packages/daemon/src/index.ts"],
      "@orca/design": ["./packages/design/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    // `*.ts` does not match `.cts`, and the app's preload is the workspace's one CommonJS
    // source (packages/app/tsconfig.preload.json). It is listed so that `pnpm run typecheck`
    // and ESLint's type-aware rules — which resolve files through this project — both see it.
    "packages/app/src/preload/**/*.cts",
    "packages/*/test/**/*.ts",
    "docs/preparation/tool-execution-guards/contract.ts",
    "examples/**/*.ts",
    "vitest.config.ts",
    "vitest.renderer.config.ts",
    "vitest.global-setup.ts",
    "packages/app/vite.config.ts"
  ]
}
