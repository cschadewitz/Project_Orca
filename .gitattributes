# Generated by packages/design/build-tokens.js — collapse in PR diffs, but keep them
# committed so nothing has to run a build to read a token.
packages/design/css/tokens.css linguist-generated=true
packages/design/src/tokens.ts  linguist-generated=true

# Generated by tools/font-build/build-fonts.js. Binary, and collapsed in PR diffs for the
# same reason as the tokens: committed so the app can render without a build step.
packages/design/fonts/*.woff2 binary linguist-generated=true

# The selector compares executed source bytes with immutable Git blobs.
# Preserve that exact-byte boundary on Windows checkouts too.
tools/ci-shadow/*.js text eol=lf
tools/ci-shadow/*.json text eol=lf

# The #402 native Mac fixture pins SHA-256 digests of these exact bytes (manifest,
# sealed identity, daemon and stub archives), and the app's Mac update tests read them.
tools/deploy/tests/native-mac/fixtures/** text eol=lf

# The first-run sample workflow pins SHA-256 digests of the accepted #420 coding
# fixture's template files and reference patch.
examples/beta-first-job/template/** text eol=lf
docs/preparation/beta-first-job/reference.patch text eol=lf

# The diagnostics native package manifest records a SHA-256 of these sources
# (diagnostics-native-package.js sourceDigest), and static inspection (#779) recomputes it
# from a checkout on another OS. Keep the bytes identical on Windows checkouts.
packages/app/native/diagnostics/** text eol=lf

# The app icon, rendered from packages/design/brand/orrery-icon-light*.svg (docs/design/README.md).
packages/app/build/icon.* binary

# An old release's store for the upgrade launch check (#863): exact bytes, collapsed in diffs.
packages/app/test/fixtures/store-v*/store/** text eol=lf linguist-generated=true
