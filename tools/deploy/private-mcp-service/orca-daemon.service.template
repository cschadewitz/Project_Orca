[Unit]
Description=Authenticated ORCA daemon for private MCP
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=@WORKSPACE_DIR@
# Clear the manager environment before Node or tunnel-client can read it.
# Optional proxy/CA assignments must be literal reviewed values; see the runbook.
ExecStart=/usr/bin/env -i HOME=@SERVICE_HOME@ PATH=@REVIEWED_PATH@ LANG=C TMPDIR=@TMPDIR@ @NODE@ @ORCA_CLI_ENTRY@ --config @ORCA_CONFIG@ serve --host 127.0.0.1 --port 33871
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# GET http://127.0.0.1:33871/health is local liveness only.

[Install]
WantedBy=default.target
