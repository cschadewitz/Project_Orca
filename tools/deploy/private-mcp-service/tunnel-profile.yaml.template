# Review this deployment-specific file with the service profile before installation.
# Exactly one stdio binding; no Harpoon, remote listener, extra channel, or key value.
config_version: 1
control_plane:
  base_url: https://api.openai.com
  tunnel_id: @TUNNEL_ID@
  api_key: file:@CONTROL_PLANE_KEY_FILE@
  poll_channels: [main]
health:
  listen_addr: 127.0.0.1:@TUNNEL_HEALTH_PORT@
log:
  level: info
  format: struct-text
mcp:
  commands:
    - channel: main
      command: @NODE@ @LAUNCHER@ --profile @SERVICE_PROFILE@ --token-file @ORCA_TOKEN_FILE@ --credential-store @ORCA_CREDENTIAL_STORE@
