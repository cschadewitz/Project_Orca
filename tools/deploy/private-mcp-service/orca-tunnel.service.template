[Unit]
Description=Single outbound tunnel-client for authenticated ORCA MCP
Requires=orca-daemon.service
After=orca-daemon.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=6

[Service]
Type=simple
ExecStart=@TUNNEL_CLIENT@ run --profile-file @TUNNEL_PROFILE@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# No PartOf= or reverse Requires=: restarting this unit does not restart ORCA.
# The reviewed tunnel profile binds /healthz and /readyz to 127.0.0.1 only.

[Install]
WantedBy=default.target
