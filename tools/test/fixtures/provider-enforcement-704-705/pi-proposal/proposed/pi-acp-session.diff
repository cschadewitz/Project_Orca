+const FINAL_ACTION_ALLOW = 'final-allow-once'
+const FINAL_ACTION_REJECT = 'final-reject-once'
+
+type FinalActionPermissionRequest = {
+  sessionId: string
+  toolCall: { toolCallId: string; title: string; kind: 'execute'; status: 'pending'; rawInput: Record<string, unknown> }
+  options: PermissionOption[]
+}
+
+/** Typed ACP request for pi's final bash action, or null unless every field is typed and pi offered exactly its pair. */
+function finalActionPermissionRequest(sessionId: string, ev: PiRpcEvent): FinalActionPermissionRequest | null {
+  const toolCallId = stringProp(ev, 'toolCallId')
+  const command = stringProp(ev, 'command')
+  const cwd = stringProp(ev, 'cwd')
+  const executor = stringProp(ev, 'executor')
+  const offered = Array.isArray(ev.options) ? ev.options : []
+  const exactOptions =
+    offered.length === 2 &&
+    offered.some(o => o?.optionId === FINAL_ACTION_ALLOW && o?.kind === 'allow_once' && o?.effect === 'this-invocation') &&
+    offered.some(o => o?.optionId === FINAL_ACTION_REJECT && o?.kind === 'reject_once')
+  if (!toolCallId || toolCallId.startsWith('pi-ui-') || command === null || !cwd || !exactOptions) return null
+  if (executor !== 'local' && executor !== 'custom') return null
+  return {
+    sessionId,
+    toolCall: {
+      // pi's own tool call id, the one already announced; never a synthetic UI id.
+      toolCallId,
+      title: `Run final ${stringProp(ev, 'toolName') ?? 'bash'} command`,
+      kind: 'execute',
+      status: 'pending',
+      rawInput: {
+        command,
+        cwd,
+        executor,
+        shell: ev.shell ?? null,
+        envKeys: Array.isArray(ev.envKeys) ? ev.envKeys : null,
+        timeout: ev.timeout ?? null,
+        transformations: Array.isArray(ev.transformations) ? ev.transformations : null
+      }
+    },
+    options: [
+      { optionId: FINAL_ACTION_ALLOW, name: 'Allow this exact command once', kind: 'allow_once' },
+      { optionId: FINAL_ACTION_REJECT, name: 'Reject', kind: 'reject_once' }
+    ]
+  }
+}
+
+/** An offered option for a still-current request, or null. Names and labels never authorize. */
+function finalActionSelection(
+  request: FinalActionPermissionRequest,
+  response: PermissionResponse,
+  current: boolean
+): string | null {
+  if (!current || response?.outcome?.outcome !== 'selected') return null
+  const optionId = response.outcome.optionId
+  return request.options.some(option => option.optionId === optionId) ? optionId : null
+}
