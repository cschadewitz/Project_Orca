+  private async handleFinalActionAuthorization(ev: PiRpcEvent, id: string): Promise<void> {
+    const request = finalActionPermissionRequest(this.sessionId, ev)
+    const turn = this.pendingTurn
+    if (request === null || turn === null || this.cancelRequested || !this.currentToolCalls.has(request.toolCall.toolCallId)) {
+      await this.proc.sendExtensionUiResponse({ id, cancelled: true })
+      return
+    }
+
+    let response: PermissionResponse
+    try {
+      response = await this.conn.requestPermission(request)
+    } catch {
+      await this.proc.sendExtensionUiResponse({ id, cancelled: true })
+      return
+    }
+
+    // Recheck after the await: same turn, not cancelled, tool call still open.
+    const current =
+      this.pendingTurn === turn && !this.cancelRequested && this.currentToolCalls.has(request.toolCall.toolCallId)
+    const optionId = finalActionSelection(request, response, current)
+    await this.proc.sendExtensionUiResponse(
+      optionId === null
+        ? { id, cancelled: true }
+        : { id, authorization: { toolCallId: request.toolCall.toolCallId, optionId } }
+    )
+  }
