+const FINAL_ACTION_ALLOW = 'final-allow-once'
+const FINAL_ACTION_REJECT = 'final-reject-once'
+
+type FinalActionPermissionRequest = {
+  sessionId: string
+  toolCall: { toolCallId: string; title: string; kind: 'execute'; status: 'pending'; rawInput: Record<string, unknown> }
+  options: PermissionOption[]
+}
+
+/** Typed ACP request for pi's final bash action, or null unless every field is typed and pi offered exactly its pair. */
+function finalActionPermissionRequest(sessionId: string, ev: PiRpcEvent): FinalActionPermissionRequest | null {
+  const toolCallId = stringProp(ev, 'toolCallId')
+  const toolName = stringProp(ev, 'toolName')
+  const command = stringProp(ev, 'command')
+  const cwd = stringProp(ev, 'cwd')
+  const executor = stringProp(ev, 'executor')
+  const offered = Array.isArray(ev.options) ? ev.options : []
+  const exactOptions =
+    offered.length === 2 &&
+    offered.some(o => o?.optionId === FINAL_ACTION_ALLOW && o?.kind === 'allow_once' && o?.effect === 'this-invocation') &&
+    offered.some(o => o?.optionId === FINAL_ACTION_REJECT && o?.kind === 'reject_once')
+  if (!toolCallId || toolCallId.startsWith('pi-ui-') || command === null || !cwd || !exactOptions) return null
+  if (executor !== 'local' && executor !== 'custom') return null
+  // Every forwarded fact is typed too: a local executor names its shell, a custom one names none.
+  const shell = finalActionShell(ev.shell)
+  const envKeys = ev.envKeys
+  const transformations = ev.transformations
+  const timeout = ev.timeout
+  if (toolName === null || shell === undefined || (executor === 'local') !== (shell !== null)) return null
+  if (!Array.isArray(envKeys) || !envKeys.every(key => typeof key === 'string')) return null
+  if (!Array.isArray(transformations) || !transformations.every(t => FINAL_ACTION_TRANSFORMATIONS.includes(t))) return null
+  if (timeout !== null && (typeof timeout !== 'number' || !Number.isFinite(timeout))) return null
+  return {
+    sessionId,
+    toolCall: {
+      // pi's own tool call id, the one already announced; never a synthetic UI id.
+      toolCallId,
+      title: `Run final ${toolName} command`,
+      kind: 'execute',
+      status: 'pending',
+      rawInput: {
+        command,
+        cwd,
+        executor,
+        shell,
+        envKeys,
+        timeout,
+        transformations
+      }
+    },
+    options: [
+      { optionId: FINAL_ACTION_ALLOW, name: 'Allow this exact command once', kind: 'allow_once' },
+      { optionId: FINAL_ACTION_REJECT, name: 'Reject', kind: 'reject_once' }
+    ]
+  }
+}
+
+const FINAL_ACTION_TRANSFORMATIONS: unknown[] = ['commandPrefix', 'contextCwd', 'spawnHook']
+
+/** pi's resolved shell config exactly, null for none, or undefined when it is anything else. */
+function finalActionShell(value: unknown): { shell: string; args: string[]; commandTransport?: 'argv' | 'stdin' } | null | undefined {
+  if (value === null) return null
+  if (typeof value !== 'object' || Array.isArray(value)) return undefined
+  const shell = value as Record<string, unknown>
+  const transport = shell.commandTransport
+  if (!Object.keys(shell).every(key => key === 'shell' || key === 'args' || key === 'commandTransport')) return undefined
+  if (typeof shell.shell !== 'string' || !Array.isArray(shell.args) || !shell.args.every(arg => typeof arg === 'string')) return undefined
+  if (transport !== undefined && transport !== 'argv' && transport !== 'stdin') return undefined
+  return transport === undefined
+    ? { shell: shell.shell, args: [...shell.args] }
+    : { shell: shell.shell, args: [...shell.args], commandTransport: transport }
+}
+
+/** An offered option for a still-current request, or null. Names and labels never authorize. */
+function finalActionSelection(
+  request: FinalActionPermissionRequest,
+  response: PermissionResponse,
+  current: boolean
+): string | null {
+  if (!current || response?.outcome?.outcome !== 'selected') return null
+  const optionId = response.outcome.optionId
+  return request.options.some(option => option.optionId === optionId) ? optionId : null
+}
