+/** The options a final-action request offers. Allow is one use for this one tool call. */
+const FINAL_ACTION_OPTIONS = Object.freeze([
+	Object.freeze({ optionId: "final-allow-once", kind: "allow_once", effect: "this-invocation" }),
+	Object.freeze({ optionId: "final-reject-once", kind: "reject_once", effect: "this-invocation" }),
+]);
+
+/** Typed request for one final action. Environment values stay in pi; only their names are sent. */
+function finalActionRequest(action: BashFinalAction): Record<string, unknown> {
+	return {
+		method: "authorize_final_action",
+		toolCallId: action.toolCallId,
+		toolName: action.toolName,
+		executor: action.executor,
+		shell: action.shell ?? null,
+		command: action.command,
+		cwd: action.cwd,
+		envKeys: Object.keys(action.env).sort(),
+		timeout: action.timeout ?? null,
+		transformations: action.transformations,
+		options: FINAL_ACTION_OPTIONS,
+	};
+}
+
+/** Allow only the offered allow option for this tool call; text, confirm, cancel or anything else blocks. */
+function finalActionDecision(action: BashFinalAction, response: unknown): BashFinalDecision {
+	const authorization =
+		typeof response === "object" && response !== null && !("cancelled" in response && response.cancelled)
+			? (response as { authorization?: unknown }).authorization
+			: undefined;
+	if (
+		typeof authorization === "object" &&
+		authorization !== null &&
+		(authorization as { toolCallId?: unknown }).toolCallId === action.toolCallId &&
+		(authorization as { optionId?: unknown }).optionId === FINAL_ACTION_OPTIONS[0].optionId
+	) {
+		return { outcome: "allow", action };
+	}
+	return { outcome: "block", reason: "final action was not authorized for this tool call" };
+}
