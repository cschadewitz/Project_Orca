{
  "name": "@orca/app",
  "version": "0.1.0",
  "private": true,
  "description": "ORCA desktop app (Electron): monitoring, configuration and later orchestration over the daemon protocol.",
  "type": "module",
  "main": "./dist/main/index.js",
  "desktopName": "orca-desktop.desktop",
  "author": "ORCA",
  "homepage": "https://github.com/cschadewitz/Project_Orca",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build:daemon": "node scripts/build-daemon.js",
    "build:diagnostics-native": "node scripts/diagnostics-native-package.js",
    "start": "electron .",
    "package": "electron-builder --publish never",
    "typecheck:renderer": "tsc -p renderer/tsconfig.json"
  },
  "dependencies": {
    "@orca/core": "workspace:*",
    "@orca/design": "workspace:*",
    "@orca/protocol": "workspace:*",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@orca/daemon": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.8"
  }
}
