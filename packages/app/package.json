    "package": "electron-builder",
    "typecheck:renderer": "tsc -p renderer/tsconfig.json"
  },
  "dependencies": {
    "@orca/design": "workspace:*",
    "@orca/protocol": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orca/daemon": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0"
  }
}
