diff --git a/packages/daemon/test/security-control-integration.test.ts b/packages/daemon/test/security-control-integration.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/daemon/test/security-control-integration.test.ts
@@ -0,0 +1,107 @@
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { describe, expect, it, vi } from "vitest";
+import { ControlModel, ReadModel } from "@orca/daemon";
+import { runLeaseResource } from "@orca/engine";
+import { harness } from "./security-harness.js";
+
+describe("Cal control integration", () => {
+  it("does not persist a rule for invalid, leased or stale permission decisions", async () => {
+    const h = await harness();
+    const dir = await mkdtemp(join(tmpdir(), "orca-always-order-"));
+    const file = join(dir, "permissions.json");
+    try {
+      const stepRunId = (await h.orchestrator.pendingInputs(h.runs.alice))[0]!.stepRunId;
+      await h.append({
+        type: "agent.session.opened",
+        runId: h.runs.alice,
+        payload: {
+          stepRunId,
+          sessionId: "permission-session",
+          agentId: "builder",
+          hostId: "local",
+          cwd: "/tmp",
+        },
+      });
+      await h.append({
+        type: "human.requested",
+        runId: h.runs.alice,
+        payload: {
+          stepRunId,
+          requestId: "permission-ask",
+          kind: "permission",
+          question: "Edit?",
+          options: [
+            { id: "allow", label: "Allow" },
+            { id: "deny", label: "Deny" },
+          ],
+          context: {
+            toolCall: {
+              toolCallId: "tool",
+              title: "Edit lib/a.ts",
+              kind: "edit",
+              locations: [{ path: "/tmp/lib/a.ts" }],
+            },
+          },
+        },
+      });
+      const control = new ControlModel({
+        orchestrator: h.orchestrator,
+        reads: new ReadModel({ orchestrator: h.orchestrator }),
+        permissionsFile: file,
+      });
+      const params = {
+        requestId: "permission-ask",
+        runId: h.runs.alice,
+        optionId: "allow",
+        resume: false,
+        always: { decision: "allow" as const },
+      };
+      await expect(control.answerInput({ ...params, optionId: "invalid" })).rejects.toMatchObject({
+        code: "INPUT_OPTION_UNKNOWN",
+      });
+      await expect(readFile(file)).rejects.toMatchObject({ code: "ENOENT" });
+      const lease = await h.stores.leases.acquire({ resource: runLeaseResource(h.runs.alice), holder: "other-writer" });
+      await expect(control.answerInput(params)).rejects.toMatchObject({ code: "RUN_LEASED_ELSEWHERE" });
+      await expect(readFile(file)).rejects.toMatchObject({ code: "ENOENT" });
+      await h.stores.leases.release(lease);
+      const accepted = await control.answerInput(params);
+      expect(accepted.permission?.added.length).toBeGreaterThan(0);
+      const saved = await readFile(file, "utf8");
+      await expect(
+        control.answerInput({ ...params, optionId: "deny", always: { decision: "deny" } }),
+      ).rejects.toMatchObject({ code: "INPUT_ANSWERED" });
+      expect(await readFile(file, "utf8")).toBe(saved);
+    } finally {
+      await h.close();
+      await rm(dir, { recursive: true, force: true });
+    }
+  });
+
+  it("attributes the exact admitted run before execution despite a competing same-workflow root", async () => {
+    const h = await harness();
+    try {
+      const start = h.orchestrator.startRun.bind(h.orchestrator);
+      let unrelated = "";
+      vi.spyOn(h.orchestrator, "startRun").mockImplementationOnce(async (opts) => {
+        unrelated = await start({ workflowId: opts.workflowId! });
+        return start(opts);
+      });
+      const drive = h.orchestrator.run.bind(h.orchestrator);
+      const runs: string[] = [];
+      vi.spyOn(h.orchestrator, "run").mockImplementation(async (runId, ...rest) => {
+        expect(h.ownership.owner(runId)).toBe("alice");
+        expect(h.ownership.owner(unrelated)).toBeUndefined();
+        runs.push(runId);
+        return drive(runId, ...rest);
+      });
+      const result = await h.rpc(h.tokens.alice, "runs.start", { workflowId: "gated" });
+      expect(result.body.ok).toBe(true);
+      expect(runs).toEqual([(result.body.result as { runId: string }).runId]);
+    } finally {
+      vi.restoreAllMocks();
+      await h.close();
+    }
+  });
+});
