{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prepared-roots/snapshot-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputs", "at", "entries", "workspaceEntries", "shims", "git", "existingOutputs", "capacity"],
  "properties": {
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseCommit",
        "source",
        "root",
        "sourceBranch",
        "branch",
        "commonDir",
        "gitDir",
        "receipt",
        "receiptSha256",
        "ready",
        "readySha256",
        "runId",
        "stepRunId",
        "nodeId",
        "inputId",
        "generation",
        "profile",
        "manifests",
        "lock",
        "inventorySha256",
        "workspaceSha256",
        "shimInventorySha256",
        "tools"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baseCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{40}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "device", "inode", "uid"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "device", "inode", "uid"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "sourceBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commonDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gitDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "runId", "repo", "commonDir", "baseCommit", "branch", "path"],
          "properties": {
            "version": {
              "const": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "commonDir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "baseCommit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{40}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "receiptSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gitDir"],
          "properties": {
            "gitDir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "readySha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 256
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "gitBlob"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{64}$"
            },
            "gitBlob": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "inventorySha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspaceSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "shimInventorySha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 256
        }
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mode", "bytes", "sha256", "target", "device", "inode", "nlink"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
          },
          "kind": {
            "enum": ["directory", "file", "symlink"]
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-f0-9]{64}$"
          },
          "target": {
            "type": "string",
            "maxLength": 256
          },
          "device": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nlink": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "maxItems": 256
    },
    "workspaceEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mode", "bytes", "sha256", "target", "device", "inode", "nlink"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
          },
          "kind": {
            "enum": ["directory", "file", "symlink"]
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-f0-9]{64}$"
          },
          "target": {
            "type": "string",
            "maxLength": 256
          },
          "device": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nlink": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "maxItems": 256
    },
    "shims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "template",
          "beforeSha256",
          "afterSha256",
          "unchangedBytesSha256",
          "prefixEdits",
          "afterBytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
          },
          "template": {
            "enum": ["reviewed-pnpm-posix-v1", "unknown"]
          },
          "beforeSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-f0-9]{64}$"
          },
          "afterSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-f0-9]{64}$"
          },
          "unchangedBytesSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-f0-9]{64}$"
          },
          "prefixEdits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "afterBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "maxItems": 256
    },
    "git": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "filterKeys",
          "indexTags",
          "gitlinks",
          "gitmodules",
          "trackedClean",
          "registrationValid",
          "pathsNoSymlinks"
        ],
        "properties": {
          "role": {
            "enum": ["source", "root"]
          },
          "filterKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 256
          },
          "indexTags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 256
          },
          "gitlinks": {
            "type": "boolean"
          },
          "gitmodules": {
            "type": "boolean"
          },
          "trackedClean": {
            "type": "boolean"
          },
          "registrationValid": {
            "type": "boolean"
          },
          "pathsNoSymlinks": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 256
    },
    "existingOutputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
      },
      "maxItems": 256
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileSha256",
        "at",
        "hostAvailableBytes",
        "rssBytes",
        "virtualBytes",
        "rlimitAsSoft",
        "rlimitAsHard",
        "rlimitDataSoft",
        "rlimitDataHard",
        "cgroupMembershipCount",
        "cgroupMountCount",
        "ancestorsComplete",
        "cgroups",
        "diskFreeBytes"
      ],
      "properties": {
        "profileSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hostAvailableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rssBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "virtualBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rlimitAsSoft": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rlimitAsHard": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rlimitDataSoft": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rlimitDataHard": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cgroupMembershipCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cgroupMountCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ancestorsComplete": {
          "type": "boolean"
        },
        "cgroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "isHierarchyRoot", "currentBytes", "maxBytes", "highBytes"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "isHierarchyRoot": {
                "type": "boolean"
              },
              "currentBytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxBytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "highBytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 256
        },
        "diskFreeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
