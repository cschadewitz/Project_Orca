{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prepared-roots/contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "inputs", "backend", "outputs", "requiredChecks", "capacity", "validity"],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "trusted-prepared-root"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseCommit",
        "source",
        "root",
        "sourceBranch",
        "branch",
        "commonDir",
        "gitDir",
        "receipt",
        "receiptSha256",
        "ready",
        "readySha256",
        "runId",
        "stepRunId",
        "nodeId",
        "inputId",
        "generation",
        "profile",
        "manifests",
        "lock",
        "inventorySha256",
        "workspaceSha256",
        "shimInventorySha256",
        "tools"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baseCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{40}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "device", "inode", "uid"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "device", "inode", "uid"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "sourceBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commonDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gitDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "runId", "repo", "commonDir", "baseCommit", "branch", "path"],
          "properties": {
            "version": {
              "const": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "commonDir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "baseCommit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{40}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "receiptSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gitDir"],
          "properties": {
            "gitDir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "readySha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stepRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 256
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "gitBlob"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{64}$"
            },
            "gitBlob": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "inventorySha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspaceSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "shimInventorySha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 256
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "wrapperSha256", "copierSha256", "relocationSha256", "collectorSha256"],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{40}$"
        },
        "wrapperSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "copierSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "relocationSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        },
        "collectorSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!(?:[^/]+/)*(?:\\.{1,2}|\\.git|\\.orca)(?:/|$))[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+(?:/[^/\\\\\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+)*$"
      },
      "maxItems": 256
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "largestFileBytes",
        "retainedShimBytes",
        "manifestBytes",
        "minimumAvailableBytes",
        "minimumFreeBytes"
      ],
      "properties": {
        "largestFileBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retainedShimBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manifestBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimumAvailableBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimumFreeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "expiresAt", "checkpointMaxAgeMs"],
      "properties": {
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checkpointMaxAgeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
