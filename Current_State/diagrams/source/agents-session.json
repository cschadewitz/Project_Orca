{
  "id": "agents-session",
  "title": "ACP session lifecycle",
  "owner": "packages/agents",
  "scope": "acp-session.ts, session.ts and config-options.ts",
  "kind": "component",
  "claims": [
    {
      "classification": "Implemented",
      "statement": "openAcpSession spawns a process, connects ACP, initializes capabilities, then creates a new ACP session with cwd and configured MCP servers.",
      "evidence": 1
    },
    {
      "classification": "Implemented",
      "statement": "One active prompt is admitted per session; timeout/abort requests cancellation, grace expiry fails the turn and termination escalates from SIGTERM to SIGKILL.",
      "evidence": 2
    },
    {
      "classification": "Implemented",
      "statement": "ACP fs handlers restrict absolute paths lexically to configured roots, then delegate to HostFileSystem; they do not sandbox direct agent OS operations.",
      "evidence": 3
    },
    {
      "classification": "Implemented",
      "statement": "The concrete adapter creates session/new and exposes no session/load method through AgentSession. Engine run replay therefore is distinct from restoring an ACP conversation.",
      "evidence": 4
    }
  ],
